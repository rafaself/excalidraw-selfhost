{
  "name": "excalidraw-selfhost",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:pages": "npm run build && wrangler pages dev dist --r2=DIAGRAMS",
    "dev:remote": "npm run build && wrangler pages dev dist --config wrangler.remote.jsonc",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint src functions",
    "typecheck": "tsc --noEmit && tsc -p functions/tsconfig.json",
    "postinstall": "node scripts/copy-excalidraw-assets.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260731.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "wrangler": "^4.118.0"
  }
}
